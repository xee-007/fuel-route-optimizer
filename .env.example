# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# True for local development only.
DJANGO_DEBUG=True

# Comma-separated host names the server may answer to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Free API key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
